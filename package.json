{
  "name": "@shahriarbijoy/eslint-plugin-jev",
  "version": "0.2.0",
  "description": "ESLint rules that are plain-English questions, judged by TypeSafe's Jev model. Lint for meaning, not shape.",
  "repository": { "type": "git", "url": "git+https://github.com/ShahriarBijoy/eslint-plugin-jev.git" },
  "homepage": "https://shahriarbijoy.github.io/eslint-plugin-jev/",
  "bugs": { "url": "https://github.com/ShahriarBijoy/eslint-plugin-jev/issues" },
  "author": "Shahriar Bijoy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "release": "changeset publish",
    "smoke": "tsx scripts/live-smoke.ts",
    "record:replay": "tsx scripts/record-replay.ts",
    "bench": "tsx bench/run.ts",
    "bench:report": "tsx bench/report.ts"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "jev",
    "typesafe",
    "semantic-lint",
    "ai"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
